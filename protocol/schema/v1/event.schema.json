{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/greadee/agent-action-visualizer/protocol/schema/v1/event.schema.json",
  "title": "Agent Action Visualizer normalized event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "source_type",
    "source_confidence",
    "timestamp"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "session_id": { "type": "string", "maxLength": 128 },
    "project_id": { "type": "string", "maxLength": 128 },
    "agent_id": { "type": "string", "maxLength": 128 },
    "agent_type": { "type": "string", "maxLength": 64 },
    "adapter_id": { "type": "string", "maxLength": 128 },
    "adapter_version": { "type": "string", "maxLength": 64 },
    "source_type": {
      "type": "string",
      "enum": [
        "native_hook",
        "structured_stream",
        "editor",
        "filesystem",
        "git",
        "wrapper",
        "synthetic"
      ]
    },
    "source_confidence": {
      "type": "string",
      "enum": ["exact", "correlated", "observed", "inferred"]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "session_started",
        "session_stopped",
        "agent_started",
        "agent_stopped",
        "tool_started",
        "tool_completed",
        "file_focused",
        "file_read",
        "file_created",
        "file_modified",
        "file_patched",
        "file_renamed",
        "file_moved",
        "file_deleted",
        "directory_created",
        "directory_renamed",
        "directory_deleted",
        "command_started",
        "command_completed",
        "access_interval_opened",
        "access_interval_closed",
        "diff_calculated",
        "project_rescanned",
        "adapter_connected",
        "adapter_disconnected",
        "adapter_warning",
        "event_dropped_or_coalesced"
      ]
    },
    "operation": { "type": "string", "maxLength": 64 },
    "status": { "type": "string", "maxLength": 64 },
    "timestamp": { "type": "string", "format": "date-time" },
    "monotonic_timestamp": { "type": "integer", "minimum": 0 },
    "correlation_id": { "type": "string", "maxLength": 128 },
    "parent_event_id": { "type": "string", "maxLength": 128 },
    "process_id": { "type": "integer", "minimum": 0 },
    "thread_id": { "type": "string", "maxLength": 128 },
    "turn_id": { "type": "string", "maxLength": 128 },
    "tool_name": { "type": "string", "maxLength": 256 },
    "command": { "type": "string", "maxLength": 4096 },
    "project_root": { "type": "string", "maxLength": 4096 },
    "path": { "type": "string", "maxLength": 4096 },
    "previous_path": { "type": "string", "maxLength": 4096 },
    "node_id": { "type": "string", "maxLength": 128 },
    "is_directory": { "type": "boolean" },
    "is_binary": { "type": "boolean" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "lines_added": { "type": "integer", "minimum": 0 },
    "lines_deleted": { "type": "integer", "minimum": 0 },
    "bytes_before": { "type": "integer", "minimum": 0 },
    "bytes_after": { "type": "integer", "minimum": 0 },
    "content_hash_before": { "type": "string", "maxLength": 256 },
    "content_hash_after": { "type": "string", "maxLength": 256 },
    "phase_id": { "type": "string", "maxLength": 64 },
    "slice_id": { "type": "string", "maxLength": 64 },
    "action_label": { "type": "string", "maxLength": 256 },
    "metadata": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
