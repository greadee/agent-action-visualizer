{
  "name": "@aav/desktop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "benchmark:render": "vitest bench --run tests/rendering.bench.ts",
    "benchmark:scale": "vitest bench --run tests/renderingScale.bench.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "postinstall": "node scripts/write-node-modules-go-boundary.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@prool-ui/react": "file:vendor/prool-ui/prool-ui-react-0.1.0.tgz",
    "@prool-ui/themes": "file:vendor/prool-ui/prool-ui-themes-0.1.0.tgz",
    "@prool-ui/tokens": "file:vendor/prool-ui/prool-ui-tokens-0.1.0.tgz",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
